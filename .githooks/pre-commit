#!/bin/sh
# Glyph Weaver pre-commit hook
# Invokes PowerShell script for checks

# Robust repo-root resolution (works regardless of how git invokes the hook)
GIT_ROOT=$(git rev-parse --show-toplevel)

# Workflow YAML validation (Node.js, no deps needed)
if [ -f "$GIT_ROOT/scripts/validate-workflows.mjs" ]; then
  node "$GIT_ROOT/scripts/validate-workflows.mjs" || exit 1
fi

if command -v pwsh.exe >/dev/null 2>&1; then
    pwsh.exe -NoProfile -File "$GIT_ROOT/.githooks/pre-commit.ps1"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File "$GIT_ROOT/.githooks/pre-commit.ps1"
else
    echo "WARNING: pwsh not found, skipping pre-commit checks"
    exit 0
fi
